{
  "info": {
    "name": "Semantic FAQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "dev-api-key"
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add: Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Reset password\",\n  \"content\": \"Click 'Forgot password' on the login page and follow the emailed link to choose a new one.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status field present\", () => pm.expect(pm.response.json().embedding_status).to.be.oneOf([\"ready\",\"pending\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add: Refund policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Refund policy\",\n  \"content\": \"Purchases can be refunded within 30 days if the product is unused. Contact billing to start a refund.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status field present\", () => pm.expect(pm.response.json().embedding_status).to.be.oneOf([\"ready\",\"pending\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add: Office hours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Office hours\",\n  \"content\": \"Support is available Monday to Friday, 9am to 5pm UTC.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status field present\", () => pm.expect(pm.response.json().embedding_status).to.be.oneOf([\"ready\",\"pending\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Ask",
      "item": [
        {
          "name": "Ask (semantic: should rank 'Reset password' first)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"I can't log in, how do I get a new password?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json().results;",
                  "pm.test(\"at most 3 results\", () => pm.expect(r.length).to.be.at.most(3));",
                  "pm.test(\"each has a score\", () => r.forEach(x => pm.expect(x.score).to.be.a(\"number\")));",
                  "pm.test(\"sorted by score desc\", () => { for (let i=1;i<r.length;i++) pm.expect(r[i-1].score).to.be.at.least(r[i].score); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask (repeat question)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"I can't log in, how do I get a new password?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask (refunds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"can I get my money back?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Maintenance",
      "item": [
        {
          "name": "Re-embed pending documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/reembed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "reembed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (503 means the model is down)\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"reports counts\", () => { pm.expect(b.reembedded).to.be.a(\"number\"); pm.expect(b.remaining).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}